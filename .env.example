# Untuk Railway: variabel ini diisi otomatis oleh plugin MySQL Railway
# MYSQLHOST=...
# MYSQLPORT=3306
# MYSQLUSER=...
# MYSQLPASSWORD=...
# MYSQLDATABASE=...

# Untuk lokal (XAMPP/phpMyAdmin):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=absensi_magang

# Wajib diisi (ganti dengan string acak panjang & rahasia)
JWT_SECRET=ganti-dengan-string-rahasia-yang-panjang

# Railway mengisi ini otomatis
PORT=3000
NODE_ENV=production
